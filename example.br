import random

let base = 42

println("hi")
mut score = base * 2
let letted_score = score
score = calculate_stuff(score)
if score == 4200 {
    println("Oh wow, that is very interesting")
} else {
    println("oh no...")
}

for i in 0..score {
    println("{}", i)
    print("wow ")
    if random.randi_range(0, 20) == 2 {
      println("{} is great", letted_score * i)
    }
}

fn calculate_stuff(score: int) {
    return score * 42
}
